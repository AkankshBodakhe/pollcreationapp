    @Override
    public void getVotesByUser(String email) {
        User user = userDao.getUserbyEmail(email)
                .orElseThrow(() -> new ResourceNotFoundException("User not found with email: " + email));

        List<PollVote> votes = pollVoteDao.findByVoter(user);

        if (votes.isEmpty()) {
            System.out.println("No votes found for the user with email: " + email);
            return;
        }

        votes.forEach(vote -> {
            System.out.println("Poll ID: " + vote.getPoll().getId());
            System.out.println("Poll Question: " + vote.getPoll().getQuestion());
            System.out.println("Selected Option ID: " + vote.getSelectedOption().getId());
            System.out.println("Selected Option Text: " + vote.getSelectedOption().getOptionText());
            System.out.println("Poll Created By: " + vote.getPoll().getCreatedBy().getEmail());
            System.out.println("--------------------------------------");
        });
    }
