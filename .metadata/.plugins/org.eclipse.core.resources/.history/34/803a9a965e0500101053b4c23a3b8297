package com.akanksh.repository;

import com.akanksh.entity.Poll;
import org.springframework.data.jpa.repository.JpaRepository;
import java.util.List;
import java.util.Optional;

public interface PollRepository extends JpaRepository<Poll, Long> {

    List<Poll> findByCreatedById(Long userId);

    Optional<Poll> findByIdAndCreatedById(Long pollId, Long userId);

    List<Poll> findByIsActiveTrue();

    List<Poll> findByExpiryDateBeforeAndIsActiveTrue(java.time.LocalDateTime now);

}
