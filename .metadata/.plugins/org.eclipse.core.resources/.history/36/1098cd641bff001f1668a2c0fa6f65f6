@Service
public class OtpServiceImpl implements OtpService {

	private static final int OTP_LENGTH = 6;
	private static final int OTP_EXPIRATION_MINUTES = 5;

	@Autowired
	private OtpDao otpDao;

	@Autowired
	private ModelMapper modelMapper;

	@Override
	public boolean generateAndSendOtp(String email, OtpPurpose purpose) {
		String otpCode = generateOtp();
		LocalDateTime expirationTime = LocalDateTime.now().plusMinutes(OTP_EXPIRATION_MINUTES);

		Optional<Otp> existingOtp = otpDao.findByEmailAndPurpose(email, purpose);
		if(existingOtp.isPresent()){
			otpDao.deleteOtp(existingOtp.get());
		}
		
        Otp otp = new Otp();
        otp.setEmail(email);
        otp.setOtp(otpCode);
        otp.setPurpose(purpose);
        otp.setExpirationTime(expirationTime);

        otpDao.save(otp);

        // Send OTP via email (Mocking this step)
        sendOtpByEmail(email, otpCode);

        return true;

	}

	@Override
	public boolean validateOtp(OtpDto otpDto) {
