	private String generateOtp() {
		Random random = new Random();
		StringBuilder otp = new StringBuilder();

		for (int i = 0; i < OTP_LENGTH; i++) {
			otp.append(random.nextInt(10)); // Generate a random digit (0-9)
		}

		return otp.toString();
	}

}
