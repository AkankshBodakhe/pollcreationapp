package com.akanksh.dao;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

import com.akanksh.entity.PollVote;
import com.akanksh.entity.User;
import com.akanksh.repository.PollVoteRepository;

@Repository
public class PollVoteDaoImpl implements PollVoteDao {

    @Autowired
    private PollVoteRepository pollVoteRepository;

    @Override
    public void saveVote(PollVote pollVote) {
        pollVoteRepository.save(pollVote);
    }

    @Override
    public Optional<PollVote> findByPollIdAndVoterEmail(Long pollId, String email) {
        return pollVoteRepository.findByPollIdAndVoter_Email(pollId, email);
    }
    
    @Override
    public List<PollVote> findByVoter(User user) {
        return pollVoteRepository.findByVoter_Email(user.getEmail());
    }
}