        }).collect(Collectors.toList());
    }

    @Transactional
    @Override
    public void deleteVote(Long pollId, String voterEmail) {
        User user = userDao.getUserbyEmail(voterEmail)
                .orElseThrow(() -> new ResourceNotFoundException("User not found with email: " + voterEmail));

        Poll poll = pollDao.findById(pollId)
                .orElseThrow(() -> new ResourceNotFoundException("Poll not found with ID: " + pollId));

        if (!poll.isActive()) {
            throw new IllegalStateException("Cannot delete vote. Poll is not active.");
        }

        // Delete vote
        pollVoteDao.deleteVotesByPollAndVoter(poll, user);
    }

    
    @Transactional
    @Override
    public void updatePoll(UpdatePollRequestDto updateRequest) {
        Poll poll = pollDao.findById(pollId)
                .orElseThrow(() -> new ResourceNotFoundException("Poll not found with ID: " + pollId));

        boolean deleteVotes = false;

        if (!poll.getQuestion().equals(updateRequest.getQuestion())) {
            deleteVotes = true;
        }
        
        if (poll.isAllowMultipleSelect() != updateRequest.isAllowMultipleSelect()) {
            deleteVotes = true;
        }

        if (!poll.getOptions().equals(updateRequest.getOptions())) {
            deleteVotes = true;
        }

        if (deleteVotes) {
            List<PollVote> votes = pollVoteDao.findByPoll(poll);
            if (!votes.isEmpty()) {
                pollDao.deleteVotesByPoll(poll);
                emailService.sendVoteDeletedNotification(poll, votes);
            }
        }

        poll.setQuestion(updateRequest.getQuestion());
        poll.setAllowMultipleSelect(updateRequest.isAllowMultipleSelect());
        poll.setOptions(updateRequest.getOptions());

        pollDao.save(poll);
    }
    
