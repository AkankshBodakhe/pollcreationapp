package com.akanksh.repository;

import com.akanksh.entity.PollVote;
import org.springframework.data.jpa.repository.JpaRepository;
import java.util.List;
import java.util.Optional;

public interface PollVoteRepository extends JpaRepository<PollVote, Long> {

    List<PollVote> findByPollId(Long pollId);

    List<PollVote> findByVoterId(Long userId);

    Optional<PollVote> findByPollIdAndVoterId(Long pollId, Long userId);

    long countByPollIdAndSelectedOptionId(Long pollId, Long optionId);
}
