package com.akanksh.dao;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

import com.akanksh.entity.PollOption;
import com.akanksh.repository.PollOptionRepository;

@Repository
public class PollOptionDaoImpl implements PollOptionDao {

	 @Autowired
	 private PollOptionRepository pollOptionRepository;

	@Override
	public Optional<PollOption> findById(Long id) {
		return pollOptionRepository.findById(id);
	}
	
    @Override
    public List<PollOption> saveAll(List<PollOption> pollOptions) {
        return pollOptionRepository.saveAll(pollOptions);
    }
    
    @Override
    public List<PollOption> findByPollId(Long pollId) {
        return pollOptionRepository.findByPollId(pollId);
    }

}
